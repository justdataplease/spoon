rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validRecipeId(recipeId) {
      return recipeId.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    function validPlanId(planId) {
      return planId.matches(
        '^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])$'
      );
    }

    function validEpochMillis(value) {
      return value is int &&
        value > 0 &&
        value <= 253402300799999;
    }

    function validCategory(value) {
      return value in [
        'legumes',
        'poultry',
        'vegetables',
        'meat',
        'fish',
        'street_food',
        'pasta_rice',
        'dessert',
        'other',
        'any'
      ];
    }

    function validText(value, minimum, maximum) {
      return value is string &&
        value.size() >= minimum &&
        value.size() <= maximum;
    }

    function validCustomRecipeId(recipeId) {
      return recipeId.matches(
        '^custom_[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-5][0-9A-Fa-f]{3}-[89AaBb][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$'
      );
    }

    function validShoppingItem(data, itemId) {
      return data.keys().hasAll([
          'name',
          'quantity',
          'unit',
          'info',
          'recipeId',
          'recipeTitle',
          'sectionTitle',
          'checked',
          'createdAtEpochMillis',
          'updatedAtEpochMillis'
        ]) &&
        data.keys().hasOnly([
          'name',
          'quantity',
          'unit',
          'info',
          'recipeId',
          'recipeTitle',
          'sectionTitle',
          'checked',
          'createdAtEpochMillis',
          'updatedAtEpochMillis'
        ]) &&
        validRecipeId(itemId) &&
        validText(data.name, 1, 200) &&
        validText(data.quantity, 0, 100) &&
        validText(data.unit, 0, 100) &&
        validText(data.info, 0, 500) &&
        data.recipeId is string &&
        (data.recipeId == '' || validRecipeId(data.recipeId)) &&
        validText(data.recipeTitle, 0, 300) &&
        validText(data.sectionTitle, 0, 200) &&
        data.checked is bool &&
        validEpochMillis(data.createdAtEpochMillis) &&
        validEpochMillis(data.updatedAtEpochMillis) &&
        data.updatedAtEpochMillis >= data.createdAtEpochMillis;
    }

    function validRecipeNote(data, noteId) {
      return data.keys().hasAll(['recipeId', 'text', 'updatedAtEpochMillis']) &&
        data.keys().hasOnly(['recipeId', 'text', 'updatedAtEpochMillis']) &&
        validRecipeId(noteId) &&
        data.recipeId is string &&
        data.recipeId == noteId &&
        validText(data.text, 1, 10000) &&
        validEpochMillis(data.updatedAtEpochMillis);
    }

    function validCustomRecipe(data, recipeId) {
      return data.keys().hasAll([
          'title',
          'description',
          'category',
          'prepMinutes',
          'cookMinutes',
          'servings',
          'ingredientSections',
          'methodSections',
          'photoDataUri',
          'active',
          'createdAtEpochMillis',
          'updatedAtEpochMillis'
        ]) &&
        data.keys().hasOnly([
          'title',
          'description',
          'category',
          'prepMinutes',
          'cookMinutes',
          'servings',
          'ingredientSections',
          'methodSections',
          'photoDataUri',
          'active',
          'createdAtEpochMillis',
          'updatedAtEpochMillis'
        ]) &&
        validCustomRecipeId(recipeId) &&
        validText(data.title, 1, 300) &&
        validText(data.description, 0, 10000) &&
        data.category is string &&
        validCategory(data.category) &&
        data.category != 'any' &&
        data.prepMinutes is int &&
        data.prepMinutes >= 0 &&
        data.prepMinutes <= 10080 &&
        data.cookMinutes is int &&
        data.cookMinutes >= 0 &&
        data.cookMinutes <= 10080 &&
        validText(data.servings, 0, 100) &&
        data.ingredientSections is list &&
        data.ingredientSections.size() > 0 &&
        data.ingredientSections.size() <= 20 &&
        data.methodSections is list &&
        data.methodSections.size() > 0 &&
        data.methodSections.size() <= 20 &&
        data.photoDataUri is string &&
        data.photoDataUri.size() <= 700000 &&
        data.photoDataUri.matches('^$|^data:image/jpeg;base64,[A-Za-z0-9+/=]+$') &&
        data.active is bool &&
        validEpochMillis(data.createdAtEpochMillis) &&
        validEpochMillis(data.updatedAtEpochMillis) &&
        data.updatedAtEpochMillis >= data.createdAtEpochMillis;
    }

    function validCookedMeal(data, historyId) {
      return data.keys().hasAll([
          'date',
          'recipeId',
          'recipeTitle',
          'completedAtEpochMillis'
        ]) &&
        data.keys().hasOnly([
          'date',
          'recipeId',
          'recipeTitle',
          'completedAtEpochMillis'
        ]) &&
        validPlanId(historyId) &&
        data.date is string &&
        data.date == historyId &&
        data.recipeId is string &&
        validRecipeId(data.recipeId) &&
        validText(data.recipeTitle, 1, 300) &&
        validEpochMillis(data.completedAtEpochMillis);
    }

    function planHasConsistentHistory(uid, plan, planId) {
      let historyPath = /databases/$(database)/documents/spoon/$(uid)/cookedHistory/$(planId);
      return (plan.completed == false && !existsAfter(historyPath)) ||
        (
          plan.completed == true &&
          existsAfter(historyPath) &&
          getAfter(historyPath).data.date == plan.date &&
          getAfter(historyPath).data.recipeId == plan.recipeId &&
          getAfter(historyPath).data.recipeTitle == plan.recipeTitle &&
          getAfter(historyPath).data.completedAtEpochMillis == plan.updatedAtEpochMillis
        );
    }

    function historyMatchesCompletedPlan(uid, history, historyId) {
      let planPath = /databases/$(database)/documents/spoon/$(uid)/mealPlans/$(historyId);
      return existsAfter(planPath) &&
        getAfter(planPath).data.completed == true &&
        getAfter(planPath).data.date == history.date &&
        getAfter(planPath).data.recipeId == history.recipeId &&
        getAfter(planPath).data.recipeTitle == history.recipeTitle &&
        getAfter(planPath).data.updatedAtEpochMillis == history.completedAtEpochMillis;
    }

    function historyCanBeDeleted(uid, historyId) {
      let planPath = /databases/$(database)/documents/spoon/$(uid)/mealPlans/$(historyId);
      return existsAfter(planPath) &&
        getAfter(planPath).data.completed == false;
    }

    function validFilters(filters, planCategory) {
      return filters is map &&
        filters.keys().hasAll([
          'category',
          'easeLevel',
          'minRating',
          'maxPrepMinutes'
        ]) &&
        filters.keys().hasOnly([
          'category',
          'easeLevel',
          'minRating',
          'maxPrepMinutes'
        ]) &&
        filters.category is string &&
        filters.category == planCategory &&
        validCategory(filters.category) &&
        filters.easeLevel is string &&
        filters.easeLevel in ['', 'easy', 'moderate', 'involved', 'unknown'] &&
        filters.minRating is number &&
        filters.minRating >= 0 &&
        filters.minRating <= 10 &&
        filters.maxPrepMinutes is int &&
        filters.maxPrepMinutes >= 0 &&
        filters.maxPrepMinutes <= 10080;
    }

    function validMealPlan(data, planId, uid) {
      return data.keys().hasAll([
          'date',
          'category',
          'recipeId',
          'recipeTitle',
          'filters',
          'completed',
          'updatedAtEpochMillis'
        ]) &&
        data.keys().hasOnly([
          'date',
          'category',
          'recipeId',
          'recipeTitle',
          'filters',
          'completed',
          'updatedAtEpochMillis'
        ]) &&
        validPlanId(planId) &&
        data.date is string &&
        data.date == planId &&
        data.category is string &&
        validCategory(data.category) &&
        data.recipeId is string &&
        validRecipeId(data.recipeId) &&
        data.recipeTitle is string &&
        data.recipeTitle.size() > 0 &&
        data.recipeTitle.size() <= 300 &&
        validFilters(data.filters, data.category) &&
        data.completed is bool &&
        planHasConsistentHistory(uid, data, planId) &&
        validEpochMillis(data.updatedAtEpochMillis);
    }

    function validFavorite(data, favoriteId) {
      return data.keys().hasAll(['recipeId', 'addedAtEpochMillis']) &&
        data.keys().hasOnly(['recipeId', 'addedAtEpochMillis']) &&
        validRecipeId(favoriteId) &&
        data.recipeId is string &&
        data.recipeId == favoriteId &&
        validEpochMillis(data.addedAtEpochMillis);
    }

    // Trusted Admin SDK importers bypass rules. Signed-in clients can only
    // read the normalized catalog and can never mutate it.
    match /spoon_recipes/{recipeId} {
      allow get: if signedIn() &&
        validRecipeId(recipeId) &&
        resource.data.active == true &&
        resource.data.language == 'el';
      // Collection queries cannot prove a regex constraint over every
      // document ID. The two data predicates below are enforced by the app's
      // query and still exclude retired or non-Greek catalog entries.
      allow list: if signedIn() &&
        resource.data.active == true &&
        resource.data.language == 'el';
      allow create, update, delete: if false;
    }

    // Rich normalized content is fetched only when a recipe is opened. Listing
    // the whole details collection is deliberately disabled for mobile clients.
    match /spoon_recipe_details/{recipeId} {
      allow get: if signedIn() &&
        validRecipeId(recipeId) &&
        resource.data.active == true &&
        resource.data.language == 'el';
      allow list, create, update, delete: if false;
    }

    // The complete authorized source envelope is retained for audit/re-import,
    // but only trusted Admin SDK tooling may access it (Admin bypasses rules).
    match /spoon_recipe_payloads/{recipeId} {
      allow read, write: if false;
    }

    // Exact server-owned status document read by CatalogFreshnessWorker.
    match /spoon_catalog/status {
      allow get: if signedIn();
      allow list, create, update, delete: if false;
    }

    // Meal plans are owner-readable. The app creates/replaces plans and
    // updates completion, but has no meal-plan deletion operation.
    match /spoon/{uid}/mealPlans/{planId} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid) &&
        validMealPlan(request.resource.data, planId, uid);
      allow delete: if false;
    }

    // Favorites use create/delete toggles. Updates and extra fields are denied.
    match /spoon/{uid}/favorites/{favoriteId} {
      allow get, list: if isOwner(uid);
      allow create: if isOwner(uid) &&
        validFavorite(request.resource.data, favoriteId);
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    match /spoon/{uid}/shoppingItems/{itemId} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid) &&
        validShoppingItem(request.resource.data, itemId);
      allow delete: if isOwner(uid);
    }

    match /spoon/{uid}/recipeNotes/{noteId} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid) &&
        validRecipeNote(request.resource.data, noteId);
      allow delete: if isOwner(uid);
    }

    match /spoon/{uid}/customRecipes/{recipeId} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid) &&
        validCustomRecipe(request.resource.data, recipeId);
      allow delete: if isOwner(uid);
    }

    match /spoon/{uid}/cookedHistory/{historyId} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid) &&
        validCookedMeal(request.resource.data, historyId) &&
        historyMatchesCompletedPlan(uid, request.resource.data, historyId);
      allow delete: if isOwner(uid) &&
        historyCanBeDeleted(uid, historyId);
    }

    // App Check enforcement is configured for Cloud Firestore in Firebase,
    // separately from this authentication/authorization rules language.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
