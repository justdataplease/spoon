<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/calendar_widget_background" android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="2dp" android:layout_marginHorizontal="8dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/calendar_widget_previous"
            android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp"
            android:background="@drawable/calendar_widget_day_background" android:src="@drawable/calendar_widget_previous"
            android:contentDescription="@string/calendar_widget_previous_month" />
        <TextView android:id="@+id/calendar_widget_month"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:text="@string/calendar_widget_loading_month"
            android:textColor="#2D2520" android:textSize="18sp" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:ellipsize="end" android:background="@drawable/calendar_widget_day_background" />
        <ImageButton android:id="@+id/calendar_widget_next"
            android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp"
            android:background="@drawable/calendar_widget_day_background" android:src="@drawable/calendar_widget_next"
            android:contentDescription="@string/calendar_widget_next_month" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp"
        android:paddingHorizontal="10dp"><include layout="@layout/calendar_widget_weekdays" /></LinearLayout>
    <LinearLayout android:id="@+id/calendar_widget_weeks" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="2" android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="4dp" android:orientation="vertical" />
    <FrameLayout android:id="@+id/calendar_widget_recipe"
        android:layout_width="match_parent" android:layout_height="96dp"
        android:minHeight="96dp" android:background="#3F4032" android:focusable="true">
        <ImageView android:id="@+id/calendar_widget_recipe_photo"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:src="@drawable/today_recipe_widget_placeholder"
            android:importantForAccessibility="no" android:contentDescription="@null" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitXY" android:src="@drawable/today_recipe_widget_scrim"
            android:importantForAccessibility="no" android:contentDescription="@null" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:orientation="vertical" android:paddingHorizontal="16dp"
            android:paddingBottom="14dp" android:paddingTop="8dp">
            <TextView android:id="@+id/calendar_widget_selected_date"
                android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical"
                android:textColor="#E6FFFFFF" android:textSize="11sp" android:fontFamily="sans-serif-medium"
                android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
                android:focusable="true" />
            <TextView android:id="@+id/calendar_widget_recipe_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/calendar_widget_choose_meal" android:textColor="#FFFFFF" android:textSize="15sp"
                android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"
                android:includeFontPadding="false" android:shadowColor="#66000000" android:shadowRadius="2"
                android:shadowDy="1" android:importantForAccessibility="no" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
